# === CONFIGURACIÓN BOT WHATSAPP ===
# Este archivo muestra las variables de entorno necesarias
# Copia este archivo a .env y ajusta los valores

# Google Calendar
CALENDAR_ID=tu-email@gmail.com

# Emojis para comandos
EMOJI_AGENDAR=🗓️
EMOJI_CANCELAR=🚫

# Zona horaria (lista: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones)
TZ=America/Argentina/Buenos_Aires

# Configuración de recordatorios (hora en formato 24h)
REMINDER_HOUR=7
REMINDER_MINUTE=0

# Duración por defecto de turnos (minutos)
DEFAULT_DURATION=60

# Puerto del servidor web (Render lo asigna automáticamente)
PORT=3000

# Token de administración (opcional, para endpoints protegidos)
ADMIN_TOKEN=

# Configuración avanzada (opcionales)
LOG_RETENTION=50
EVENTS_CACHE_TTL_MS=60000
MAX_RECONNECT_BEFORE_RESET=10
KEEP_ALIVE_INTERVAL_MS=50000

# === CREDENCIALES GOOGLE ===
# Opción 1: Usar archivos credentials.json y token.json en la raíz
# Opción 2: Usar variables de entorno (recomendado para Render)

# GOOGLE_OAUTH_CLIENT={"installed":{"client_id":"...","client_secret":"...","redirect_uris":["..."]}}
# GOOGLE_OAUTH_TOKEN={"access_token":"...","refresh_token":"...","scope":"...","token_type":"Bearer","expiry_date":...}

# O para Service Account:
# GOOGLE_CREDENTIALS={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
